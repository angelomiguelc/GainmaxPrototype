<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#edf4fa">
  <title>Project tracker | Gainmax</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { color-scheme: light; --ink: #17324f; --muted: #687b94; --line: #dfe8f2; --blue: #174a8b; --orange: #bd5200; --green: #147467; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; color: var(--ink); font-family: 'DM Sans', sans-serif; background-color: #edf4fa; background-image: radial-gradient(#d7e3f1 0.8px, transparent 0.8px); background-size: 18px 18px; }
    button, input, select, textarea { font: inherit; }
    .font-display { font-family: 'Manrope', sans-serif; }
    .app-shell { min-height: 100dvh; max-width: 760px; margin: 0 auto; overflow: hidden; background: #fff; box-shadow: 0 22px 80px #163e6b20; }
    @media (min-width: 800px) { .app-shell { min-height: min(1000px, calc(100dvh - 48px)); margin: 24px auto; border: 1px solid #d6e2f0; border-radius: 24px; } }
    .tab-panel[hidden] { display: none; }
    .signature-canvas { touch-action: none; }
    .stage-button:disabled { cursor: default; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }
  </style>
</head>
<body>
  <% const projectId = project?.id || ''; %>
  <% const projectCurrency = project?.estimate?.currency || 'SGD'; %>
  <% const projectMoney = new Intl.NumberFormat(projectCurrency === 'SGD' ? 'en-SG' : 'en-MY', { style: 'currency', currency: projectCurrency, maximumFractionDigits: 2 }); %>
  <% const contractSum = project?.estimate?.totalCost || 24800; %>
  <% const paymentMilestones = project?.paymentMilestones || [{ percentage: 20, amount: contractSum * 0.2, label: 'Project confirmation' }, { percentage: 30, amount: contractSum * 0.3, label: 'Before installation' }, { percentage: 50, amount: contractSum * 0.5, label: 'Project handover' }]; %>
  <% const currentStage = Math.min(10, Math.max(1, Number(project?.currentStage) || 1)); %>
  <% const projectComplete = Boolean(project?.completedAt); %>
  <% const clientStages = [
    ['Pre-con survey', 'Site conditions and roof access are reviewed.'],
    ['Finalise drawing', 'System layout is prepared for final review.'],
    ['Purchasing of stock (BOM)', 'Equipment is ordered against the approved bill of materials.'],
    ['Shipping update', 'Equipment dispatch is being coordinated.'],
    ['Shipment arrival', 'Equipment arrival and stock checks are confirmed.'],
    ['SKOM', 'Review the kick-off details and agree before site work proceeds.'],
    ['Timeline finalised', 'Installation dates and the work sequence are confirmed.'],
    ['Start work (Toolbox meeting)', 'The team completes its site safety meeting.'],
    ['Work in progress', 'Installation work is underway at your property.'],
    ['Handover', 'Final installation and project handover are complete.'],
  ]; %>
  <main id="projectContext" data-project-id="<%= projectId %>" data-current-stage="<%= currentStage %>" data-project-complete="<%= projectComplete %>" data-skom-signed="<%= Boolean(project?.skomSigned) %>" class="app-shell flex flex-col pb-24 sm:pb-0">
    <header class="sticky top-0 z-20 border-b border-[#e1eaf5] bg-white/95 px-5 pb-3 pt-[max(14px,env(safe-area-inset-top))] backdrop-blur sm:px-8">
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5" aria-label="Gainmax portal switcher">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#174a8b] text-[#f28c28]"><i data-lucide="sun" class="h-5 w-5"></i></span>
          <span class="font-display text-[17px] font-extrabold">gainmax<span class="text-[#174a8b]">.</span></span>
        </a>
        <div class="flex items-center gap-2">
          <span class="hidden rounded-full bg-[#eaf5f3] px-3 py-1.5 text-[10px] font-bold uppercase text-[#147467] sm:inline-flex">Client portal</span>
          <a href="/logout" class="grid h-9 w-9 place-items-center rounded-lg border border-[#dbe5f1] text-[#536982]" aria-label="Log out" title="Log out"><i data-lucide="log-out" class="h-4 w-4"></i></a>
        </div>
      </div>
    </header>

    <div class="mx-auto w-full max-w-[680px] flex-1 px-4 pb-8 pt-5 sm:px-8 sm:pt-7">
      <section aria-labelledby="projectTitle" class="overflow-hidden rounded-2xl bg-[#123d74] text-white">
        <div class="p-5 sm:p-6">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[.16em] text-sky-200">Onboarded project · <%= project ? project.id.slice(0, 8).toUpperCase() : 'GMX-24018' %></p>
              <h1 id="projectTitle" class="mt-2 font-display text-[23px] font-extrabold leading-tight sm:text-[27px]">Your solar project</h1>
              <p class="mt-1 text-sm text-sky-100"><%= project ? `${project.property} property · ${project.country === 'SG' ? 'Singapore' : 'Malaysia'}` : 'Residential rooftop · Singapore' %></p>
            </div>
            <span id="currentStageBadge" class="max-w-[145px] rounded-full bg-white/15 px-3 py-1.5 text-right text-[10px] font-bold leading-4 text-white"><%= projectComplete ? 'Project complete' : `Stage ${currentStage} · ${clientStages[currentStage - 1][0]}` %></span>
          </div>
          <div class="mt-6 flex items-end justify-between gap-4 border-t border-white/20 pt-4">
            <div><p class="text-[10px] font-semibold uppercase tracking-[.12em] text-sky-200">Contract sum</p><p class="mt-1 font-display text-[27px] font-extrabold"><%= projectMoney.format(contractSum) %></p></div>
            <div class="text-right"><p class="text-[10px] text-sky-200">Project progress</p><p id="progressLabel" class="mt-1 text-sm font-bold"><%= projectComplete ? 10 : currentStage - 1 %> of 10 stages complete</p></div>
          </div>
          <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/20"><div id="projectProgress" class="h-full rounded-full bg-[#f28c28] transition-[width]" style="width:<%= projectComplete ? 100 : (currentStage - 1) * 10 %>%"></div></div>
        </div>
      </section>

      <section aria-labelledby="invoicesTitle" class="mt-7">
        <div class="mb-3 flex items-end justify-between gap-3">
          <div><p class="text-[10px] font-bold uppercase tracking-[.14em] text-[#687b94]">Payment plan</p><h2 id="invoicesTitle" class="mt-1 font-display text-lg font-extrabold">Milestone invoices</h2></div>
          <span class="text-[11px] font-semibold text-[#687b94]"><%= projectMoney.format(contractSum) %> total</span>
        </div>
        <div class="divide-y divide-[#e7edf5] rounded-xl border border-[#dbe5f1] bg-white px-3 sm:px-4">
          <div class="flex min-h-[76px] items-center gap-3 py-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#eaf5f3] text-[#147467]"><i data-lucide="check" class="h-4 w-4"></i></span>
            <div class="min-w-0 flex-1"><p class="text-sm font-bold"><%= paymentMilestones[0].percentage %>% · <%= paymentMilestones[0].label %></p><p class="text-xs text-[#687b94]"><%= projectMoney.format(paymentMilestones[0].amount) %> invoice</p></div>
            <button type="button" class="open-documents inline-flex min-h-9 shrink-0 items-center gap-1.5 rounded-lg border border-[#dbe5f1] px-2.5 text-[11px] font-bold text-[#174a8b] hover:bg-[#f3f7fc]" data-receipt="deposit"><i data-lucide="paperclip" class="h-3.5 w-3.5"></i>Payment Receipt</button>
          </div>
          <div class="flex min-h-[76px] items-center gap-3 py-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#fff1e4] text-[#a94d08]"><i data-lucide="clock-3" class="h-4 w-4"></i></span>
            <div class="min-w-0 flex-1"><p class="text-sm font-bold"><%= paymentMilestones[1].percentage %>% · <%= paymentMilestones[1].label %></p><p class="text-xs text-[#687b94]"><%= projectMoney.format(paymentMilestones[1].amount) %> invoice</p></div>
            <button type="button" class="open-documents inline-flex min-h-9 shrink-0 items-center gap-1.5 rounded-lg border border-[#dbe5f1] px-2.5 text-[11px] font-bold text-[#174a8b] hover:bg-[#f3f7fc]" data-receipt="preinstall"><i data-lucide="paperclip" class="h-3.5 w-3.5"></i>Payment Receipt</button>
          </div>
          <div class="flex min-h-[76px] items-center gap-3 py-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#f1f5f9] text-[#687b94]"><i data-lucide="circle-dashed" class="h-4 w-4"></i></span>
            <div class="min-w-0 flex-1"><p class="text-sm font-bold"><%= paymentMilestones[2].percentage %>% · <%= paymentMilestones[2].label %></p><p class="text-xs text-[#687b94]"><%= projectMoney.format(paymentMilestones[2].amount) %> invoice</p></div>
            <button type="button" class="open-documents inline-flex min-h-9 shrink-0 items-center gap-1.5 rounded-lg border border-[#dbe5f1] px-2.5 text-[11px] font-bold text-[#174a8b] hover:bg-[#f3f7fc]" data-receipt="handover"><i data-lucide="paperclip" class="h-3.5 w-3.5"></i>Payment Receipt</button>
          </div>
        </div>
        <p id="receiptMessage" class="mt-2 min-h-4 text-xs text-[#687b94]" aria-live="polite">Receipts and project files are available in Documents.</p>
      </section>

      <nav class="mt-7 grid grid-cols-4 gap-1 rounded-xl bg-[#f1f5f9] p-1" aria-label="Client portal sections" role="tablist">
        <button type="button" class="portal-tab rounded-lg px-1.5 py-2.5 text-[9px] font-bold <%= activeTab === 'project' ? 'bg-white text-[#174a8b] shadow-sm' : 'text-[#687b94]' %> sm:text-xs" role="tab" aria-selected="<%= activeTab === 'project' %>" data-tab="project"><i data-lucide="layers-3" class="mx-auto mb-1 h-4 w-4"></i>Project</button>
        <button type="button" class="portal-tab rounded-lg px-1.5 py-2.5 text-[9px] font-bold <%= activeTab === 'documents' ? 'bg-white text-[#174a8b] shadow-sm' : 'text-[#687b94]' %> sm:text-xs" role="tab" aria-selected="<%= activeTab === 'documents' %>" data-tab="documents"><i data-lucide="folder-down" class="mx-auto mb-1 h-4 w-4"></i>Documents</button>
        <button type="button" class="portal-tab rounded-lg px-1.5 py-2.5 text-[9px] font-bold <%= activeTab === 'referrals' ? 'bg-white text-[#174a8b] shadow-sm' : 'text-[#687b94]' %> sm:text-xs" role="tab" aria-selected="<%= activeTab === 'referrals' %>" data-tab="referrals"><i data-lucide="users-round" class="mx-auto mb-1 h-4 w-4"></i>Referrals</button>
        <button type="button" class="portal-tab rounded-lg px-1.5 py-2.5 text-[9px] font-bold <%= activeTab === 'feedback' ? 'bg-white text-[#174a8b] shadow-sm' : 'text-[#687b94]' %> sm:text-xs" role="tab" aria-selected="<%= activeTab === 'feedback' %>" data-tab="feedback"><i data-lucide="message-square-heart" class="mx-auto mb-1 h-4 w-4"></i>Feedback</button>
      </nav>

      <section id="projectPanel" class="tab-panel mt-7" role="tabpanel" aria-labelledby="projectTitle" <%= activeTab === 'project' ? '' : 'hidden' %>>
        <div class="mb-4 flex items-end justify-between gap-3">
          <div><p class="text-[10px] font-bold uppercase tracking-[.14em] text-[#687b94]">Installation journey</p><h2 class="mt-1 font-display text-lg font-extrabold">Project progress</h2></div>
          <span class="text-xs font-semibold text-[#687b94]">10 stages</span>
        </div>
        <ol class="overflow-hidden rounded-xl border border-[#dbe5f1] bg-white" aria-label="Project stages">
          <% clientStages.forEach(([title, detail], index) => { %>
            <% const stageNumber = index + 1; %>
            <% const isComplete = projectComplete || stageNumber < currentStage; %>
            <% const isCurrent = !projectComplete && stageNumber === currentStage; %>
            <li class="relative flex gap-3 border-b border-[#edf0ed] px-3.5 py-3 last:border-b-0 sm:px-4 <%= isCurrent ? 'bg-[#f3f7fc]' : '' %>">
              <span class="relative z-10 grid h-7 w-7 shrink-0 place-items-center rounded-full border text-[10px] font-extrabold <%= isComplete ? 'border-[#147467] bg-[#147467] text-white' : isCurrent ? 'border-[#174a8b] bg-white text-[#174a8b]' : 'border-[#d5dee8] bg-white text-[#8796a9]' %>"><%= isComplete ? '✓' : stageNumber %></span>
              <div class="min-w-0 flex-1"><div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1"><h3 class="text-xs font-bold leading-4 <%= stageNumber > currentStage && !projectComplete ? 'text-[#8796a9]' : 'text-[#425975]' %>"><%= title %></h3><span class="text-[9px] font-bold uppercase tracking-wide <%= isComplete ? 'text-[#147467]' : isCurrent ? 'text-[#a94d08]' : 'text-[#a1adbb]' %>"><%= isComplete ? 'Complete' : isCurrent ? 'In progress' : 'Upcoming' %></span></div><p class="mt-1 text-[11px] leading-4 text-[#687b94]"><%= detail %></p></div>
            </li>
          <% }); %>
        </ol>
        <% if (project && currentStage === 6) { %>
          <section class="mt-4 rounded-xl border border-[#dbe5f1] bg-[#f7fafc] p-4 sm:p-5" aria-labelledby="skomTitle">
            <div class="flex items-start gap-3"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-[#eaf2fc] text-[#174a8b]"><i data-lucide="file-signature" class="h-5 w-5"></i></span><div><h3 id="skomTitle" class="font-display text-sm font-extrabold">SKOM · Agree to proceed</h3><p class="mt-1 text-xs leading-5 text-[#687b94]">Review the project kick-off and authorize your installation to proceed.</p></div></div>
            <% if (project.skomSigned) { %>
              <p id="skomMessage" class="mt-4 rounded-lg bg-[#eaf5f3] px-3 py-2.5 text-xs font-bold text-[#147467]">Agreement signed<% if (project.skomSignedAt) { %> on <%= new Date(project.skomSignedAt).toLocaleDateString('en-SG', { dateStyle: 'medium' }) %><% } %>. Your engineer will update the next project stage.</p>
            <% } else { %>
              <label for="skomSignature" class="mb-2 mt-4 block text-xs font-bold text-[#425975]">Digital signature</label>
              <canvas id="skomSignature" class="signature-canvas h-32 w-full rounded-lg border border-dashed border-[#a9bacb] bg-white" width="640" height="160" aria-label="Draw your signature to agree to proceed"></canvas>
              <div class="mt-2 flex flex-wrap items-center justify-between gap-3"><button type="button" class="clear-signature text-xs font-bold text-[#536982] underline">Clear signature</button><button id="agreeToProceed" type="button" class="min-h-10 rounded-lg bg-[#147467] px-3.5 text-xs font-bold text-white disabled:cursor-not-allowed disabled:opacity-50" disabled>Agree to proceed</button></div>
              <p id="skomMessage" class="mt-2 min-h-4 text-xs text-[#687b94]" aria-live="polite">Draw your signature above to enable agreement.</p>
            <% } %>
          </section>
        <% } %>
      </section>

      <section id="documentsPanel" class="tab-panel mt-7" role="tabpanel" aria-label="Project documents" <%= activeTab === 'documents' ? '' : 'hidden' %>>
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-[.14em] text-[#687b94]">Project files</p><h2 class="mt-1 font-display text-lg font-extrabold">Documents &amp; Deliverables</h2><p class="mt-1 text-sm text-[#687b94]">Download project documents and add milestone payment receipts.</p></div><span class="rounded-full bg-[#edf4fc] px-3 py-1.5 text-[10px] font-bold text-[#174a8b]"><%= projectId || 'Demo project' %></span></div>
        <% if (receiptUploaded) { %><p class="mb-4 rounded-lg bg-[#eaf5f3] px-3 py-2.5 text-xs font-semibold text-[#147467]" role="status">Payment receipt uploaded to this project.</p><% } %>
        <div class="space-y-4">
          <% documentGroups.forEach((group) => { %>
            <section class="overflow-hidden rounded-xl border border-[#dbe5f1] bg-white" aria-labelledby="<%= group.title.replace(/[^a-z0-9]/gi, '') %>Title">
              <h3 id="<%= group.title.replace(/[^a-z0-9]/gi, '') %>Title" class="border-b border-[#e7edf5] bg-[#f7fafc] px-4 py-3 text-xs font-extrabold uppercase tracking-[.08em] text-[#536982]"><%= group.title %></h3>
              <ul class="divide-y divide-[#edf0ed]">
                <% group.documents.forEach((document) => { %>
                  <% const isReceipt = document.key.startsWith('receipt-'); %>
                  <li id="document-<%= document.key %>" class="flex flex-wrap items-center gap-3 px-3.5 py-3.5 sm:px-4">
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg <%= document.available ? 'bg-[#eaf2fc] text-[#174a8b]' : 'bg-[#f1f5f9] text-[#8b9aad]' %>"><i data-lucide="<%= isReceipt ? 'receipt' : document.available ? 'file-text' : 'file-clock' %>" class="h-5 w-5"></i></span>
                    <div class="min-w-0 flex-1"><p class="text-xs font-bold leading-4 text-[#17324f]"><%= document.title %></p><div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] text-[#687b94]"><span><%= document.stageTag %></span><% if (document.available) { %><span aria-hidden="true">·</span><span><%= document.fileType %> · <%= document.fileSize %></span><% } else { %><span class="rounded-full bg-[#f1f5f9] px-2 py-0.5 text-[9px] font-semibold">Available after stage</span><% } %></div><% if (document.available && document.filename) { %><p class="mt-1 truncate text-[10px] text-[#8796a9]"><%= document.filename %></p><% } %></div>
                    <div class="flex w-full shrink-0 items-center justify-end gap-2 sm:w-auto">
                      <% if (document.available) { %><a href="/client/projects/<%= encodeURIComponent(projectId) %>/documents/<%= encodeURIComponent(document.key) %>" class="inline-flex min-h-9 items-center gap-1.5 rounded-lg border border-[#dbe5f1] px-3 text-[10px] font-bold text-[#174a8b]" download><i data-lucide="download" class="h-3.5 w-3.5"></i>Download</a><% } %>
                      <% if (isReceipt && projectId) { %><form action="/client/projects/<%= encodeURIComponent(projectId) %>/receipts/<%= document.key.slice('receipt-'.length) %>" method="POST" enctype="multipart/form-data" class="receipt-upload-form"><label class="flex min-h-9 cursor-pointer items-center gap-1.5 rounded-lg bg-[#174a8b] px-3 text-[10px] font-bold text-white"><i data-lucide="upload" class="h-3.5 w-3.5"></i><span><%= document.available ? 'Replace receipt' : 'Upload receipt' %></span><input class="receipt-upload sr-only" type="file" name="receipt" accept="application/pdf,image/png,image/jpeg" required aria-label="Upload <%= document.title %>"></label><button class="sr-only" type="submit" tabindex="-1" aria-hidden="true">Upload</button></form><% } %>
                      <% if (!document.available && !isReceipt) { %><span class="text-[10px] font-semibold text-[#8796a9]">Pending</span><% } %>
                    </div>
                  </li>
                <% }); %>
              </ul>
            </section>
          <% }); %>
        </div>
      </section>

      <section id="referralsPanel" class="tab-panel mt-7" role="tabpanel" <%= activeTab === 'referrals' ? '' : 'hidden' %>>
        <div class="mb-4"><p class="text-[10px] font-bold uppercase tracking-[.14em] text-[#687b94]">Share the sun</p><h2 class="mt-1 font-display text-lg font-extrabold">Referral program</h2></div>
        <div class="rounded-xl bg-[#147467] p-5 text-white sm:p-6"><span class="grid h-10 w-10 place-items-center rounded-xl bg-white/15"><i data-lucide="users-round" class="h-5 w-5"></i></span><h3 class="mt-4 font-display text-xl font-extrabold">Know someone going solar?</h3><p class="mt-2 max-w-md text-sm leading-5 text-white/85">Share your project referral link with a friend or neighbour who is exploring solar.</p><div class="mt-5 flex gap-2"><input id="referralLink" readonly class="h-11 min-w-0 flex-1 rounded-lg border border-white/25 bg-white/10 px-3 text-xs text-white outline-none"><button id="copyReferral" type="button" class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg bg-white px-3 text-xs font-bold text-[#147467]"><i data-lucide="copy" class="h-4 w-4"></i><span>Copy link</span></button></div><p id="referralMessage" class="mt-2 min-h-4 text-xs text-white/80" aria-live="polite"></p></div>
      </section>

      <section id="feedbackPanel" class="tab-panel mt-7" role="tabpanel" <%= activeTab === 'feedback' ? '' : 'hidden' %>>
        <div class="mb-4"><p class="text-[10px] font-bold uppercase tracking-[.14em] text-[#687b94]">Help us improve</p><h2 class="mt-1 font-display text-lg font-extrabold">Project feedback</h2><p class="mt-1 text-sm text-[#687b94]">Tell us how the onboarding and project updates are going.</p></div>
        <form id="feedbackForm" class="space-y-4 rounded-xl border border-[#dbe5f1] bg-white p-4 sm:p-5">
          <div><label for="feedbackTopic" class="mb-1.5 block text-xs font-bold text-[#425975]">Feedback topic</label><select id="feedbackTopic" class="h-11 w-full rounded-lg border border-[#dbe5f1] bg-white px-3 text-sm outline-none focus:border-[#174a8b]"><option>Project updates</option><option>Payment process</option><option>Installation experience</option><option>Other</option></select></div>
          <div><label for="feedbackText" class="mb-1.5 block text-xs font-bold text-[#425975]">Your feedback</label><textarea id="feedbackText" rows="5" maxlength="1000" required class="w-full resize-y rounded-lg border border-[#dbe5f1] px-3 py-2.5 text-sm outline-none focus:border-[#174a8b]" placeholder="Share your thoughts"></textarea></div>
          <button class="min-h-11 rounded-lg bg-[#174a8b] px-4 text-sm font-bold text-white" type="submit">Send feedback</button>
          <p id="feedbackMessage" class="min-h-4 text-xs text-[#147467]" aria-live="polite"></p>
        </form>
      </section>
    </div>

  </main>

  <script>
    lucide.createIcons();

    const projectId = document.getElementById('projectContext').dataset.projectId;
    const skomCanvas = document.getElementById('skomSignature');
    const agreeButton = document.getElementById('agreeToProceed');
    if (skomCanvas && agreeButton) {
      const context = skomCanvas.getContext('2d');
      let signatureDrawn = false;
      let drawing = false;
      const point = (event) => {
        const rect = skomCanvas.getBoundingClientRect();
        return { x: (event.clientX - rect.left) * skomCanvas.width / rect.width, y: (event.clientY - rect.top) * skomCanvas.height / rect.height };
      };
      skomCanvas.addEventListener('pointerdown', (event) => {
        drawing = true;
        skomCanvas.setPointerCapture(event.pointerId);
        const position = point(event);
        context.beginPath();
        context.moveTo(position.x, position.y);
      });
      skomCanvas.addEventListener('pointermove', (event) => {
        if (!drawing) return;
        const position = point(event);
        context.lineWidth = 3;
        context.lineCap = 'round';
        context.lineJoin = 'round';
        context.strokeStyle = '#17324f';
        context.lineTo(position.x, position.y);
        context.stroke();
        signatureDrawn = true;
        agreeButton.disabled = false;
      });
      skomCanvas.addEventListener('pointerup', () => { drawing = false; });
      skomCanvas.addEventListener('pointercancel', () => { drawing = false; });
      document.querySelector('.clear-signature').addEventListener('click', () => {
        context.clearRect(0, 0, skomCanvas.width, skomCanvas.height);
        signatureDrawn = false;
        agreeButton.disabled = true;
        document.getElementById('skomMessage').textContent = 'Draw your signature above to enable agreement.';
      });
      agreeButton.addEventListener('click', async () => {
        if (!signatureDrawn || !projectId) return;
        agreeButton.disabled = true;
        const signatureData = skomCanvas.toDataURL('image/png');
        try {
          const response = await fetch(`/client/projects/${encodeURIComponent(projectId)}/skom`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ signatureData }),
          });
          if (!response.ok) throw new Error('Signature could not be saved.');
          document.getElementById('skomMessage').textContent = 'Agreement signed. Your engineer will update the project timeline.';
          skomCanvas.hidden = true;
          document.querySelector('.clear-signature').hidden = true;
          agreeButton.hidden = true;
        } catch (error) {
          agreeButton.disabled = false;
          document.getElementById('skomMessage').textContent = error.message || 'Could not save your agreement. Please try again.';
        }
      });
    }

    document.querySelectorAll('.open-documents').forEach((button) => {
      button.addEventListener('click', () => {
        activateTab('documents');
        document.getElementById(`document-receipt-${button.dataset.receipt}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
    document.querySelectorAll('.receipt-upload').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.files?.[0]) input.form.requestSubmit();
      });
    });

    function activateTab(tabName) {
      document.querySelectorAll('.portal-tab').forEach((tab) => {
        const active = tab.dataset.tab === tabName;
        tab.setAttribute('aria-selected', String(active));
        tab.classList.toggle('bg-white', active);
        tab.classList.toggle('shadow-sm', active);
        tab.classList.toggle('text-[#174a8b]', active);
        tab.classList.toggle('text-[#687b94]', !active);
        tab.classList.toggle('font-bold', active);
        tab.classList.toggle('font-semibold', !active);
      });
      document.querySelectorAll('.tab-panel').forEach((panel) => {
        panel.hidden = panel.id !== `${tabName}Panel`;
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    document.querySelectorAll('.portal-tab').forEach((tab) => tab.addEventListener('click', () => activateTab(tab.dataset.tab)));
    activateTab('<%= activeTab %>');

    document.getElementById('referralLink').value = `${window.location.origin}/client/project${projectId ? `?projectId=${encodeURIComponent(projectId)}` : ''}`;
    document.getElementById('copyReferral').addEventListener('click', async () => {
      const message = document.getElementById('referralMessage');
      try {
        await navigator.clipboard.writeText(document.getElementById('referralLink').value);
        message.textContent = 'Referral link copied.';
      } catch (error) {
        document.getElementById('referralLink').select();
        message.textContent = 'Select and copy your referral link.';
      }
    });

    document.getElementById('feedbackForm').addEventListener('submit', (event) => {
      event.preventDefault();
      document.getElementById('feedbackMessage').textContent = 'Thanks for sharing your feedback. It is saved for this demo session.';
      event.currentTarget.reset();
    });

  </script>
</body>
</html>
