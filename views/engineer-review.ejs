<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f3f7fc">
  <title>Engineering Queue | Gainmax</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; color: #17324f; font-family: 'DM Sans', sans-serif; background-color: #eef4fa; background-image: radial-gradient(#d7e3f1 0.8px, transparent 0.8px); background-size: 18px 18px; }
    .font-display { font-family: 'Manrope', sans-serif; }
    .app-shell { min-height: 100dvh; max-width: 1120px; margin: 0 auto; background: #fff; box-shadow: 0 22px 80px #163e6b20; }
    @media (min-width: 1160px) { .app-shell { min-height: calc(100dvh - 48px); margin: 24px auto; border: 1px solid #d6e2f0; border-radius: 24px; overflow: hidden; } }
    input, select, textarea { font: inherit; }
    input[type=checkbox] { accent-color: #174a8b; }
    .workspace { scroll-margin-top: 145px; }
  </style>
</head>
<body>
  <% const currentProject = selectedProject; %>
  <% const activeStage = currentProject ? Math.min(10, Math.max(1, Number(currentProject.currentStage) || 1)) : 0; %>
  <% const assignedCount = projects.filter((project) => project.engineering.assignedEngineer && !project.completedAt).length; %>
  <main class="app-shell">
    <header class="sticky top-0 z-20 border-b border-[#e1eaf5] bg-white/95 px-4 pb-4 pt-[max(14px,env(safe-area-inset-top))] backdrop-blur sm:px-7">
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5" aria-label="Gainmax portal switcher"><span class="grid h-9 w-9 place-items-center rounded-xl bg-[#174a8b] text-[#f28c28]"><i data-lucide="sun" class="h-5 w-5"></i></span><span class="font-display text-[17px] font-extrabold">gainmax<span class="text-[#174a8b]">.</span></span></a>
        <div class="flex items-center gap-2"><a href="/sales/leads" class="hidden min-h-9 items-center gap-1.5 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b] sm:flex"><i data-lucide="contact-round" class="h-4 w-4"></i>Sales pipeline</a><a href="/logout" class="grid h-9 w-9 place-items-center rounded-lg border border-[#dbe5f1] text-[#536982]" aria-label="Log out"><i data-lucide="log-out" class="h-4 w-4"></i></a></div>
      </div>
      <div class="mt-5"><p class="text-[10px] font-bold uppercase tracking-[.16em] text-[#687b94]">Engineering desk · EPC execution</p><h1 class="mt-1 font-display text-[23px] font-extrabold leading-tight sm:text-[27px]">Engineering &amp; Technical Queue</h1><p class="mt-1 text-sm text-[#687b94]">Manage technical work and advance active projects.</p></div>
    </header>

    <section class="px-4 pb-10 pt-5 sm:px-7 sm:pt-6">
      <div class="mb-5 grid grid-cols-2 gap-2.5 sm:max-w-md">
        <div class="rounded-xl border border-[#dce6f1] bg-white p-3.5"><p class="text-[10px] font-bold uppercase tracking-[.07em] text-[#75869a]">Active projects</p><p class="mt-1 font-display text-2xl font-extrabold"><%= projects.filter((project) => !project.completedAt).length %></p></div>
        <div class="rounded-xl border border-[#dce6f1] bg-white p-3.5"><p class="text-[10px] font-bold uppercase tracking-[.07em] text-[#75869a]">Engineer assigned</p><p class="mt-1 font-display text-2xl font-extrabold text-[#147467]"><%= assignedCount %></p></div>
      </div>

      <% if (projects.length === 0) { %>
        <div class="flex min-h-[280px] flex-col items-center justify-center rounded-2xl border border-dashed border-[#d4e1f0] bg-[#f4f8fd] px-6 text-center"><span class="grid h-12 w-12 place-items-center rounded-xl bg-white text-[#174a8b]"><i data-lucide="clipboard-list" class="h-6 w-6"></i></span><h2 class="mt-4 font-display text-lg font-extrabold">Engineering queue is clear</h2><p class="mt-1 max-w-sm text-sm leading-5 text-[#687b94]">Projects appear here after Sales completes the proposal handoff.</p><a href="/sales/leads" class="mt-4 inline-flex min-h-10 items-center gap-2 rounded-lg bg-[#174a8b] px-4 text-sm font-bold text-white"><i data-lucide="arrow-left" class="h-4 w-4"></i>Open sales pipeline</a></div>
      <% } else { %>
        <form action="/engineer/review" method="GET" class="mb-4 grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]">
          <label for="projectId" class="sr-only">Select active project</label>
          <select id="projectId" name="projectId" class="h-12 min-w-0 rounded-lg border border-[#dbe5f1] bg-white px-3 text-sm font-semibold outline-none focus:border-[#174a8b]">
            <% projects.forEach((project) => { %><option value="<%= project.id %>" <%= currentProject?.id === project.id ? 'selected' : '' %>><%= project.customerName %> · <%= project.propertyDisplay || project.property %> · <%= project.id.startsWith('GMX-') ? project.id : project.id.slice(0, 8).toUpperCase() %><%= project.completedAt ? ' · Complete' : '' %></option><% }); %>
          </select>
          <button class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-[#dbe5f1] px-4 text-xs font-bold text-[#174a8b]" type="submit"><i data-lucide="folder-open" class="h-4 w-4"></i>Open project</button>
        </form>

        <% if (currentProject) { %>
          <% const money = new Intl.NumberFormat(currentProject.estimate.currency === 'SGD' ? 'en-SG' : 'en-MY', { style: 'currency', currency: currentProject.estimate.currency, maximumFractionDigits: 2 }); %>
          <article class="overflow-hidden rounded-xl border border-[#dbe5f1] bg-white">
            <header class="border-b border-[#e8eef5] bg-[#f7fafc] p-4 sm:p-5">
              <div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><p class="text-[10px] font-bold uppercase tracking-[.1em] text-[#687b94]">Project <%= currentProject.id.startsWith('GMX-') ? currentProject.id : currentProject.id.slice(0, 8).toUpperCase() %> · <%= currentProject.completedAt ? 'Complete' : `Stage ${activeStage} of 10` %></p><h2 class="mt-1 font-display text-lg font-extrabold"><%= currentProject.customerName %></h2><p class="mt-1 text-xs text-[#687b94]"><%= currentProject.propertyDisplay || currentProject.property %> · <%= currentProject.estimate.capacityKwp.toFixed(2) %> kWp · <%= currentProject.country === 'SG' ? 'Singapore' : 'Malaysia' %></p></div><a href="/client/project?projectId=<%= encodeURIComponent(currentProject.id) %>" class="inline-flex min-h-9 items-center gap-1.5 rounded-lg border border-[#dbe5f1] bg-white px-3 text-[10px] font-bold text-[#174a8b]"><i data-lucide="external-link" class="h-3.5 w-3.5"></i>Client view</a></div>
              <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[#e4ebf2] pt-3 text-xs"><span class="font-bold">Contract <%= money.format(currentProject.estimate.totalCost) %></span><% if (currentProject.proposal) { %><a href="/engineer/projects/<%= currentProject.id %>/proposal" class="inline-flex items-center gap-1.5 font-bold text-[#174a8b]"><i data-lucide="file-down" class="h-3.5 w-3.5"></i>Sales proposal</a><% } %><span class="text-[#687b94]">Client <%= currentProject.customerEmail %></span></div>
              <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-[#dce6f1]"><div class="h-full rounded-full bg-[#174a8b]" style="width:<%= currentProject.completedAt ? 100 : (activeStage - 1) * 10 %>%"></div></div>
            </header>

            <% if (notice) { %><p class="m-4 rounded-lg bg-[#eaf5f3] px-3 py-2.5 text-xs font-semibold text-[#147467] sm:mx-5" role="status"><%= notice %></p><% } %>

            <div class="space-y-3 p-3 sm:p-5">
              <section class="rounded-lg border <%= activeStage === 1 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage1-<%= currentProject.id %>">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">1</span><h3 id="stage1-<%= currentProject.id %>" class="text-sm font-extrabold">Assign Site Engineer &amp; Site Supervisor</h3></div><span class="text-[9px] font-bold uppercase tracking-wide text-[#687b94]"><%= activeStage > 1 || currentProject.completedAt ? 'Stage complete' : activeStage === 1 ? 'Current stage' : 'Upcoming' %></span></div>
                <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST" class="grid gap-2 sm:grid-cols-[1fr_1fr_auto]"><input type="hidden" name="action" value="save-assignment"><label class="sr-only" for="engineer-<%= currentProject.id %>">Site engineer</label><input id="engineer-<%= currentProject.id %>" name="assignedEngineer" value="<%= currentProject.engineering.assignedEngineer %>" maxlength="100" required placeholder="Site engineer" class="h-10 min-w-0 rounded-lg border border-[#dbe5f1] px-3 text-sm outline-none focus:border-[#174a8b]"><label class="sr-only" for="supervisor-<%= currentProject.id %>">Site supervisor</label><input id="supervisor-<%= currentProject.id %>" name="siteSupervisor" value="<%= currentProject.engineering.siteSupervisor %>" maxlength="100" required placeholder="Site supervisor" class="h-10 min-w-0 rounded-lg border border-[#dbe5f1] px-3 text-sm outline-none focus:border-[#174a8b]"><button class="min-h-10 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b]" type="submit">Save assignment</button></form>
              </section>

              <section class="rounded-lg border <%= activeStage === 2 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage2-<%= currentProject.id %>">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">2</span><h3 id="stage2-<%= currentProject.id %>" class="text-sm font-extrabold">Engineering drawings</h3></div><span class="text-[9px] font-bold uppercase tracking-wide text-[#687b94]"><%= activeStage > 2 || currentProject.completedAt ? 'Stage complete' : activeStage === 2 ? 'Current stage' : 'Upcoming' %></span></div>
                <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST" enctype="multipart/form-data" class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_auto]"><input type="hidden" name="action" value="save-drawing"><label class="sr-only" for="prepared-<%= currentProject.id %>">Prepared by</label><input id="prepared-<%= currentProject.id %>" name="preparedBy" value="<%= currentProject.engineering.drawingPreparedBy %>" maxlength="100" required placeholder="Prepared by" class="h-10 min-w-0 rounded-lg border border-[#dbe5f1] px-3 text-sm outline-none focus:border-[#174a8b]"><label class="flex min-h-10 min-w-0 cursor-pointer items-center gap-2 overflow-hidden rounded-lg border border-dashed border-[#b8c9dc] px-3 text-xs font-semibold text-[#536982]"><i data-lucide="paperclip" class="h-4 w-4 shrink-0"></i><span class="truncate drawing-name"><%= currentProject.engineering.drawing?.filename || 'Select drawing (PDF, DWG, DXF, image)' %></span><input class="drawing-file sr-only" type="file" name="drawing" accept=".pdf,.doc,.docx,.dwg,.dxf,.png,.jpg,.jpeg" <%= currentProject.engineering.drawing ? '' : 'required' %> aria-label="Engineering drawing file"></label><button class="min-h-10 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b]" type="submit">Save drawing</button></form>
                <% if (currentProject.engineering.drawing) { %><a class="mt-2 inline-flex items-center gap-1.5 text-[10px] font-bold text-[#147467]" href="/engineer/projects/<%= currentProject.id %>/drawing"><i data-lucide="download" class="h-3 w-3"></i><%= currentProject.engineering.drawing.filename %> · prepared by <%= currentProject.engineering.drawingPreparedBy %></a><% } %>
              </section>

              <section class="rounded-lg border <%= activeStage === 3 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage3-<%= currentProject.id %>">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">3</span><h3 id="stage3-<%= currentProject.id %>" class="text-sm font-extrabold">BOM · Bill of Materials</h3></div><span class="text-[9px] font-bold uppercase tracking-wide text-[#687b94]"><%= activeStage > 3 || currentProject.completedAt ? 'Stage complete' : activeStage === 3 ? 'Current stage' : 'Upcoming' %></span></div>
                <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST"><input type="hidden" name="action" value="save-bom"><div class="grid gap-2 sm:grid-cols-3"><% [{ name: 'panels', label: 'Solar panels', icon: 'solar-panel' }, { name: 'inverters', label: 'Inverters', icon: 'zap' }, { name: 'racking', label: 'Racking system', icon: 'blocks' }].forEach((part) => { %><label class="flex min-h-11 items-center gap-2 rounded-lg bg-[#f7fafc] px-3 text-xs font-semibold"><input type="checkbox" name="<%= part.name %>" <%= currentProject.engineering.bom[part.name] ? 'checked' : '' %>><i data-lucide="<%= part.icon %>" class="h-4 w-4 text-[#174a8b]"></i><%= part.label %></label><% }); %></div><button class="mt-3 min-h-9 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b]" type="submit">Save BOM checklist</button></form>
              </section>

              <section class="rounded-lg border <%= activeStage === 4 || activeStage === 5 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage45-<%= currentProject.id %>">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">4–5</span><h3 id="stage45-<%= currentProject.id %>" class="text-sm font-extrabold">Shipping &amp; arrival tracker</h3></div><span class="text-[9px] font-bold uppercase tracking-wide text-[#687b94]">Dispatch · arrival</span></div>
                <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST"><input type="hidden" name="action" value="save-shipping"><div class="space-y-3">
                  <div class="grid grid-cols-[minmax(0,1fr)_minmax(108px,.65fr)_auto] items-center gap-2"><span class="text-xs font-bold">Mounting structure</span><label class="sr-only" for="mountingStatus-<%= currentProject.id %>">Mounting structure shipping status</label><select id="mountingStatus-<%= currentProject.id %>" name="mountingStatus" class="h-9 min-w-0 rounded-md border border-[#dbe5f1] bg-white px-2 text-[10px] font-semibold"><% ['Not dispatched', 'Dispatched', 'In transit'].forEach((status) => { %><option <%= currentProject.engineering.shipping.mounting.status === status ? 'selected' : '' %>><%= status %></option><% }); %></select><label class="flex items-center gap-1.5 text-[10px] font-semibold text-[#536982]"><input type="checkbox" name="mountingArrived" <%= currentProject.engineering.shipping.mounting.arrived ? 'checked' : '' %>>Arrived</label></div>
                  <div class="grid grid-cols-[minmax(0,1fr)_minmax(108px,.65fr)_auto] items-center gap-2"><span class="text-xs font-bold">Solar panels</span><label class="sr-only" for="panelsStatus-<%= currentProject.id %>">Solar panels shipping status</label><select id="panelsStatus-<%= currentProject.id %>" name="panelsStatus" class="h-9 min-w-0 rounded-md border border-[#dbe5f1] bg-white px-2 text-[10px] font-semibold"><% ['Not dispatched', 'Dispatched', 'In transit'].forEach((status) => { %><option <%= currentProject.engineering.shipping.panels.status === status ? 'selected' : '' %>><%= status %></option><% }); %></select><label class="flex items-center gap-1.5 text-[10px] font-semibold text-[#536982]"><input type="checkbox" name="panelsArrived" <%= currentProject.engineering.shipping.panels.arrived ? 'checked' : '' %>>Arrived</label></div>
                </div><button class="mt-3 min-h-9 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b]" type="submit">Save shipping updates</button></form>
              </section>

              <section class="flex flex-wrap items-center justify-between gap-3 rounded-lg border <%= activeStage === 6 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage6-<%= currentProject.id %>">
                <div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">6</span><div><h3 id="stage6-<%= currentProject.id %>" class="text-sm font-extrabold">SKOM · Agree to Proceed</h3><p class="mt-0.5 text-[10px] text-[#687b94]">Client authorization</p></div></div>
                <% if (currentProject.skomSigned) { %><span class="inline-flex items-center gap-1.5 rounded-full bg-[#eaf5f3] px-3 py-1.5 text-[10px] font-bold text-[#147467]"><i data-lucide="badge-check" class="h-3.5 w-3.5"></i>Signed<% if (currentProject.skomSignedAt) { %> · <%= new Date(currentProject.skomSignedAt).toLocaleDateString('en-SG', { dateStyle: 'medium' }) %><% } %></span><% } else { %><span class="inline-flex items-center gap-1.5 rounded-full bg-[#fff1e4] px-3 py-1.5 text-[10px] font-bold text-[#a94d08]"><i data-lucide="clock-3" class="h-3.5 w-3.5"></i>Awaiting client signature</span><% } %>
                <% if (currentProject.skomSignature) { %><img src="data:image/png;base64,<%= currentProject.skomSignature.toString('base64') %>" alt="Client SKOM signature" class="max-h-16 w-full object-contain sm:max-w-xs"><% } %>
              </section>

              <section class="rounded-lg border <%= activeStage === 7 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage7-<%= currentProject.id %>">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">7</span><h3 id="stage7-<%= currentProject.id %>" class="text-sm font-extrabold">Finalise installation timeline</h3></div><span class="text-[9px] font-bold uppercase tracking-wide text-[#687b94]"><%= activeStage > 7 || currentProject.completedAt ? 'Stage complete' : activeStage === 7 ? 'Current stage' : 'Upcoming' %></span></div>
                <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST" enctype="multipart/form-data" class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]"><input type="hidden" name="action" value="save-timeline"><label class="flex min-h-10 min-w-0 cursor-pointer items-center gap-2 overflow-hidden rounded-lg border border-dashed border-[#b8c9dc] px-3 text-xs font-semibold text-[#536982]"><i data-lucide="calendar-range" class="h-4 w-4 shrink-0"></i><span class="truncate timeline-name"><%= currentProject.engineering.timeline?.filename || 'Upload finalized project timeline' %></span><input class="timeline-file sr-only" type="file" name="timeline" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" <%= currentProject.engineering.timeline ? '' : 'required' %> aria-label="Finalized installation timeline"></label><button class="min-h-10 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b]" type="submit">Save timeline</button></form>
                <% if (currentProject.engineering.timeline) { %><a href="/engineer/projects/<%= currentProject.id %>/timeline" class="mt-2 inline-flex items-center gap-1.5 text-[10px] font-bold text-[#147467]"><i data-lucide="download" class="h-3 w-3"></i><%= currentProject.engineering.timeline.filename %></a><% } %>
              </section>

              <section class="rounded-lg border <%= activeStage === 8 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage8-<%= currentProject.id %>">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">8</span><h3 id="stage8-<%= currentProject.id %>" class="text-sm font-extrabold">Toolbox meeting · worker list</h3></div><span class="text-[9px] font-bold uppercase tracking-wide text-[#687b94]"><%= activeStage > 8 || currentProject.completedAt ? 'Stage complete' : activeStage === 8 ? 'Current stage' : 'Upcoming' %></span></div>
                <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST"><input type="hidden" name="action" value="save-toolbox"><label class="sr-only" for="workers-<%= currentProject.id %>">Toolbox meeting worker list</label><textarea id="workers-<%= currentProject.id %>" name="toolboxWorkers" rows="3" maxlength="4000" required placeholder="List workers attending the toolbox meeting" class="w-full resize-y rounded-lg border border-[#dbe5f1] px-3 py-2.5 text-sm outline-none focus:border-[#174a8b]"><%= currentProject.engineering.toolboxWorkers %></textarea><button class="mt-2 min-h-9 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b]" type="submit">Save worker list</button></form>
              </section>

              <section class="rounded-lg border <%= activeStage === 9 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage9-<%= currentProject.id %>">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">9</span><h3 id="stage9-<%= currentProject.id %>" class="text-sm font-extrabold">Work in progress</h3></div><span class="rounded-full bg-[#edf4fc] px-2.5 py-1 text-[9px] font-bold text-[#174a8b]"><%= currentProject.engineering.wipStatus %></span></div>
                <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST" class="space-y-2"><input type="hidden" name="action" value="save-wip"><label class="sr-only" for="wipStatus-<%= currentProject.id %>">Work in progress status</label><select id="wipStatus-<%= currentProject.id %>" name="wipStatus" class="h-10 w-full rounded-lg border border-[#dbe5f1] bg-white px-3 text-sm outline-none focus:border-[#174a8b]"><% ['Not started', 'In progress', 'On hold', 'Work complete'].forEach((status) => { %><option <%= currentProject.engineering.wipStatus === status ? 'selected' : '' %>><%= status %></option><% }); %></select><label class="sr-only" for="wipNotes-<%= currentProject.id %>">Work notes</label><textarea id="wipNotes-<%= currentProject.id %>" name="wipNotes" rows="2" maxlength="2000" placeholder="Progress notes" class="w-full resize-y rounded-lg border border-[#dbe5f1] px-3 py-2.5 text-sm outline-none focus:border-[#174a8b]"><%= currentProject.engineering.wipNotes || '' %></textarea><button class="min-h-9 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b]" type="submit">Save WIP status</button></form>
              </section>

              <section class="rounded-lg border <%= activeStage === 10 ? 'border-[#8daed1] bg-[#f8fbff]' : 'border-[#dbe5f1] bg-white' %> p-3.5 sm:p-4" aria-labelledby="stage10-<%= currentProject.id %>">
                <div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-[#eaf2fc] text-[10px] font-extrabold text-[#174a8b]">10</span><h3 id="stage10-<%= currentProject.id %>" class="text-sm font-extrabold">Final acceptance &amp; product warranty</h3></div><span class="text-[9px] font-bold uppercase tracking-wide text-[#687b94]"><%= currentProject.completedAt ? 'Project complete' : activeStage === 10 ? 'Current stage' : 'Upcoming' %></span></div>
                <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST" enctype="multipart/form-data" class="space-y-3"><input type="hidden" name="action" value="save-acceptance"><div class="grid gap-2 sm:grid-cols-2"><div><label for="acceptanceBy-<%= currentProject.id %>" class="mb-1 block text-[10px] font-bold text-[#536982]">Acceptance recorded by</label><input id="acceptanceBy-<%= currentProject.id %>" name="acceptanceBy" value="<%= currentProject.engineering.acceptanceBy %>" maxlength="100" required placeholder="Name" class="h-10 w-full rounded-lg border border-[#dbe5f1] px-3 text-sm outline-none focus:border-[#174a8b]"></div><div><label for="acceptanceNotes-<%= currentProject.id %>" class="mb-1 block text-[10px] font-bold text-[#536982]">Acceptance notes</label><input id="acceptanceNotes-<%= currentProject.id %>" name="acceptanceNotes" value="<%= currentProject.engineering.acceptanceNotes %>" maxlength="2000" placeholder="Final inspection notes" class="h-10 w-full rounded-lg border border-[#dbe5f1] px-3 text-sm outline-none focus:border-[#174a8b]"></div></div><label class="flex items-start gap-2 text-xs font-semibold leading-5 text-[#536982]"><input class="mt-1" type="checkbox" name="acceptanceComplete" <%= currentProject.engineering.acceptanceComplete ? 'checked' : '' %>>Final acceptance checklist complete</label><label class="flex min-h-10 cursor-pointer items-center gap-2 overflow-hidden rounded-lg border border-dashed border-[#b8c9dc] px-3 text-xs font-semibold text-[#536982]"><i data-lucide="shield-check" class="h-4 w-4 shrink-0"></i><span class="truncate warranty-name"><%= currentProject.engineering.warranty?.filename || 'Upload product warranty document' %></span><input class="warranty-file sr-only" type="file" name="warranty" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" <%= currentProject.engineering.warranty ? '' : 'required' %> aria-label="Product warranty document"></label><button class="min-h-9 rounded-lg border border-[#dbe5f1] px-3 text-xs font-bold text-[#174a8b]" type="submit">Save handover</button></form>
                <% if (currentProject.engineering.warranty) { %><a href="/engineer/projects/<%= currentProject.id %>/warranty" class="mt-2 inline-flex items-center gap-1.5 text-[10px] font-bold text-[#147467]"><i data-lucide="download" class="h-3 w-3"></i><%= currentProject.engineering.warranty.filename %></a><% } %>
              </section>
            </div>

            <footer class="sticky bottom-0 border-t border-[#e1eaf5] bg-white/95 p-4 backdrop-blur sm:px-5">
              <form action="/engineer/projects/<%= currentProject.id %>/update-stage" method="POST" class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3"><input type="hidden" name="action" value="advance"><div><p class="text-xs font-bold"><%= currentProject.completedAt ? 'Project complete' : `Ready to advance Stage ${activeStage}?` %></p><p class="mt-0.5 text-[10px] text-[#687b94]">Required stage information must be saved first.</p></div><button type="submit" <%= currentProject.completedAt ? 'disabled' : '' %> class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-[#174a8b] px-4 text-sm font-bold text-white disabled:cursor-not-allowed disabled:opacity-50"><%= currentProject.completedAt ? 'Project complete' : 'Advance Project to Next Stage' %><i data-lucide="arrow-right" class="h-4 w-4"></i></button></form>
            </footer>
          </article>
        <% } %>
      <% } %>
    </section>
  </main>
  <script>
    lucide.createIcons();
    document.getElementById('projectId')?.addEventListener('change', (event) => event.currentTarget.form.requestSubmit());
    document.querySelectorAll('.drawing-file, .timeline-file, .warranty-file').forEach((input) => input.addEventListener('change', () => {
      input.closest('label').querySelector('span').textContent = input.files[0]?.name || input.closest('label').querySelector('span').textContent;
    }));
  </script>
</body>
</html>
