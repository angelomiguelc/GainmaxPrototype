<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gainmax Demo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      :root {
        color-scheme: light;
        --ink: #17324f;
        --muted: #687b94;
        --line: #dde7f2;
        --brand-blue: #174a8b;
        --brand-orange: #f28c28;
        --brand-orange-button: #bd5200;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        background: #edf4fa;
        background-image: radial-gradient(#d8e4f3 0.8px, transparent 0.8px);
        background-size: 18px 18px;
        font-family: 'Segoe UI', sans-serif;
      }
      .app-shell {
        position: relative;
        min-height: 100dvh;
        max-width: 440px;
        margin: 0 auto;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 22px 80px rgba(22, 62, 107, 0.18);
      }
      @media (min-width: 480px) {
        .app-shell {
          min-height: min(900px, calc(100dvh - 48px));
          margin: 24px auto;
          border: 1px solid #d6e2f0;
          border-radius: 28px;
        }
      }
      .role-card {
        border: 1px solid var(--line);
        background: #f7fafc;
        transition: all .16s ease;
      }
      .role-card:hover {
        border-color: var(--brand-blue);
        background: #edf4ff;
      }
    </style>
  </head>
  <body>
    <main class="app-shell flex flex-col">
      <header class="border-b border-[#e7edf6] bg-[#ffffff]/95 px-5 pb-4 pt-[max(14px,env(safe-area-inset-top))] backdrop-blur">
        <div class="flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#174a8b] text-[#f28c28]">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M12 2a1 1 0 0 1 1 1v1.1A7.9 7.9 0 0 1 20.9 11H22a1 1 0 1 1 0 2h-1.1A7.9 7.9 0 0 1 13 20.9V22a1 1 0 1 1-2 0v-1.1A7.9 7.9 0 0 1 3.1 13H2a1 1 0 1 1 0-2h1.1A7.9 7.9 0 0 1 11 3.1V2a1 1 0 0 1 1-1Zm-1 5.2A5.8 5.8 0 0 0 5.2 13 5.8 5.8 0 0 0 11 18.8 5.8 5.8 0 0 0 18.8 13 5.8 5.8 0 0 0 13 5.2Zm-1 2.3a1 1 0 0 1 2 0v3.1l2.3 1.3a1 1 0 1 1-1 1.7L12 16.1a1 1 0 0 1-.5-.9V7.5Z"/></svg>
          </span>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-[#687b94]">Gainmax demo</p>
            <h1 class="font-display text-[18px] font-extrabold tracking-[-0.04em]">Choose your portal</h1>
          </div>
        </div>
      </header>

      <div class="flex-1 px-5 pb-8 pt-6">
        <div class="rounded-[28px] bg-[#123d74] p-5 text-white">
          <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-sky-200">Access</p>
          <p class="mt-3 text-sm leading-6 text-sky-100">
            This demo app simulates four user roles. Each role sees a different part of the platform without any database.
          </p>
        </div>

        <div class="mt-5 space-y-3">
          <a href="/login/customer" class="role-card flex items-center justify-between rounded-2xl px-4 py-3.5">
            <div class="flex items-center gap-3">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-[#dfeeff] text-sm font-black text-[#123d74]">C</span>
              <div>
                <p class="text-[15px] font-bold">Customer</p>
                <p class="text-xs text-[#687b94]">Quote flow</p>
              </div>
            </div>
            <span class="text-xl text-[#123d74]">→</span>
          </a>

          <a href="/login/engineer" class="role-card flex items-center justify-between rounded-2xl px-4 py-3.5">
            <div class="flex items-center gap-3">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-[#e8f7ef] text-sm font-black text-[#17714d]">E</span>
              <div>
                <p class="text-[15px] font-bold">Engineer</p>
                <p class="text-xs text-[#687b94]">Review queue</p>
              </div>
            </div>
            <span class="text-xl text-[#123d74]">→</span>
          </a>

          <a href="/login/sales" class="role-card flex items-center justify-between rounded-2xl px-4 py-3.5">
            <div class="flex items-center gap-3">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-[#fff1df] text-sm font-black text-[#a94d08]">S</span>
              <div>
                <p class="text-[15px] font-bold">Sales</p>
                <p class="text-xs text-[#687b94]">Lead desk</p>
              </div>
            </div>
            <span class="text-xl text-[#123d74]">→</span>
          </a>

          <a href="/login/admin" class="role-card flex items-center justify-between rounded-2xl px-4 py-3.5">
            <div class="flex items-center gap-3">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-[#ecebff] text-sm font-black text-[#4b3fad]">A</span>
              <div>
                <p class="text-[15px] font-bold">Admin</p>
                <p class="text-xs text-[#687b94]">Operations</p>
              </div>
            </div>
            <span class="text-xl text-[#123d74]">→</span>
          </a>
        </div>

        <% if (currentRole) { %>
          <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">
            Active session: <span class="font-black"><%= currentRole %></span>
          </div>
          <a href="/logout" class="mt-4 block text-center text-xs font-bold uppercase tracking-[0.15em] text-[#123d74]">Logout</a>
        <% } %>
      </div>
    </main>
  </body>
</html>
