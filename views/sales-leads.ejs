<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f3f7fc">
  <title>Sales leads | Gainmax</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; color: #17324f; font-family: 'DM Sans', sans-serif; background-color: #eef4fa; background-image: radial-gradient(#d7e3f1 0.8px, transparent 0.8px); background-size: 18px 18px; }
    .app-shell { min-height: 100dvh; max-width: 760px; margin: 0 auto; background: #ffffff; box-shadow: 0 22px 80px #163e6b20; }
    @media (min-width: 800px) { .app-shell { min-height: calc(100dvh - 48px); margin: 24px auto; border: 1px solid #d6e2f0; border-radius: 28px; overflow: hidden; } }
    .font-display { font-family: 'Manrope', sans-serif; }
    .brand-cta { background-color: #bd5200 !important; color: #fff !important; transition: background-color .16s ease, transform .16s ease; }
    .brand-cta:hover { background-color: #963f00 !important; }
    .brand-cta:focus-visible { outline: 3px solid #f28c28; outline-offset: 3px; }
    details[open] .expand-icon { transform: rotate(180deg); }
  </style>
</head>
<body>
  <% const acceptedCount = leads.filter((lead) => lead.status === 'Accepted').length; %>
  <% const pendingCount = leads.filter((lead) => lead.status === 'Pending').length; %>
  <main class="app-shell">
    <header class="sticky top-0 z-20 border-b border-[#e1eaf5] bg-[#ffffff]/95 px-5 pb-4 pt-[max(14px,env(safe-area-inset-top))] backdrop-blur sm:px-8">
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5" aria-label="Gainmax quotation app"><span class="grid h-9 w-9 place-items-center rounded-xl bg-[#174a8b] text-[#f28c28]"><i data-lucide="sun" class="h-5 w-5"></i></span><span class="font-display text-[17px] font-extrabold">gainmax<span class="text-[#174a8b]">.</span></span></a>
        <span class="rounded-full bg-[#fff1e4] px-3 py-1.5 text-[11px] font-bold uppercase tracking-[.6px] text-[#a85008]">Sales desk</span>
      </div>
      <div class="mt-5 flex items-end justify-between">
        <div><p class="text-[11px] font-bold uppercase tracking-[1px] text-[#687b94]">Lead management</p><h1 class="mt-1 font-display text-[26px] font-extrabold tracking-[-.6px]">Solar enquiries</h1></div>
        <a href="/" class="brand-cta mb-1 inline-flex min-h-10 items-center gap-1.5 rounded-xl bg-[#174a8b] px-3.5 text-xs font-bold text-white"><i data-lucide="plus" class="h-4 w-4"></i> New quote</a>
      </div>
    </header>

    <section class="px-5 pb-8 pt-5 sm:px-8">
      <div class="mb-5 grid grid-cols-3 gap-2.5">
        <div class="rounded-xl border border-[#dce6f1] bg-white p-3.5"><p class="text-[10px] font-bold uppercase tracking-[.6px] text-[#75869a]">All leads</p><p class="mt-1 font-display text-2xl font-extrabold"><%= leads.length %></p></div>
        <div class="rounded-xl border border-[#dce6f1] bg-white p-3.5"><p class="text-[10px] font-bold uppercase tracking-[.6px] text-[#75869a]">Pending</p><p class="mt-1 font-display text-2xl font-extrabold text-[#a16d28]"><%= pendingCount %></p></div>
        <div class="rounded-xl border border-[#dce6f1] bg-white p-3.5"><p class="text-[10px] font-bold uppercase tracking-[.6px] text-[#75869a]">Accepted</p><p class="mt-1 font-display text-2xl font-extrabold text-[#174a8b]"><%= acceptedCount %></p></div>
      </div>

      <% if (leads.length === 0) { %>
        <div class="flex min-h-[300px] flex-col items-center justify-center rounded-2xl border border-dashed border-[#d4e1f0] bg-[#f4f8fd] px-8 text-center">
          <span class="grid h-14 w-14 place-items-center rounded-2xl bg-white text-[#174a8b] shadow-sm"><i data-lucide="sun-medium" class="h-7 w-7"></i></span>
          <h2 class="mt-4 font-display text-lg font-extrabold">Your lead list is clear</h2>
          <p class="mt-1 max-w-[260px] text-sm leading-5 text-[#687b94]">Submitted customer estimates will appear here for your team to review.</p>
          <a href="/" class="brand-cta mt-5 inline-flex h-11 items-center gap-2 rounded-xl bg-[#174a8b] px-4 text-sm font-bold text-white"><i data-lucide="plus" class="h-4 w-4"></i> Create a test lead</a>
        </div>
      <% } else { %>
        <div class="mb-3 flex items-center justify-between"><h2 class="font-display text-sm font-extrabold">Latest enquiries</h2><span class="text-xs text-[#75869a]">Newest first</span></div>
        <div class="space-y-3">
          <% leads.forEach((lead, index) => { %>
            <% const formatter = new Intl.NumberFormat(lead.estimate.currency === 'SGD' ? 'en-SG' : 'en-MY', { style: 'currency', currency: lead.estimate.currency, maximumFractionDigits: 0 }); %>
            <% const statusStyles = { Pending: 'bg-[#fff2dc] text-[#936321]', Accepted: 'bg-[#e4f3e7] text-[#247344]', Rejected: 'bg-[#fae8e5] text-[#aa493b]' }; %>
            <article class="overflow-hidden rounded-2xl border border-[#dbe6f3] bg-white shadow-[0_3px_12px_#1d3a2b08]">
              <details>
                <summary class="list-none cursor-pointer p-4 sm:p-5">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><span class="font-display text-sm font-extrabold"><%= lead.customerName %></span><span class="text-[10px] font-semibold text-[#75869a]">Enquiry <%= String(leads.length - index).padStart(3, '0') %></span><span class="rounded-full px-2.5 py-1 text-[10px] font-bold <%= statusStyles[lead.status] %>"><%= lead.status %></span></div><p class="mt-1.5 text-xs text-[#687b94]"><%= lead.property %> · <%= lead.country === 'SG' ? 'Singapore' : 'Malaysia' %> · <%= new Date(lead.createdAt).toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' }) %></p></div>
                    <i data-lucide="chevron-down" class="expand-icon mt-1 h-4 w-4 shrink-0 text-[#75869a] transition-transform"></i>
                  </div>
                  <div class="mt-4 grid grid-cols-2 gap-3 border-t border-[#edf0ed] pt-3.5">
                    <div><p class="text-[10px] font-bold uppercase tracking-[.6px] text-[#75869a]">System size</p><p class="mt-1 font-display text-lg font-extrabold"><%= lead.estimate.capacityKwp.toFixed(2) %> <span class="text-xs font-semibold text-[#687b94]">kWp</span></p></div>
                    <div><p class="text-[10px] font-bold uppercase tracking-[.6px] text-[#75869a]">Estimated total</p><p class="mt-1 font-display text-lg font-extrabold"><%= formatter.format(lead.estimate.totalCost) %></p></div>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    <span class="rounded-md bg-[#f1f6fc] px-2 py-1 text-[10px] font-semibold text-[#536982]"><%= lead.panels %> panels</span>
                    <span class="rounded-md bg-[#f1f6fc] px-2 py-1 text-[10px] font-semibold text-[#536982]"><%= lead.roof %></span>
                    <span class="rounded-md bg-[#f1f6fc] px-2 py-1 text-[10px] font-semibold text-[#536982]"><%= lead.meter %></span>
                    <% if (lead.postalCode) { %><span class="rounded-md bg-[#f1f6fc] px-2 py-1 text-[10px] font-semibold text-[#536982]">Postal code <%= lead.postalCode %></span><% } %>
                  </div>
                </summary>
                <div class="border-t border-[#edf0ed] bg-[#fbfcfa] px-4 pb-4 pt-3 sm:px-5">
                  <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-xs">
                    <div class="col-span-2"><dt class="text-[#75869a]">Customer email</dt><dd class="mt-0.5 break-all font-semibold"><a href="mailto:<%= lead.customerEmail %>" class="text-[#174a8b]"><%= lead.customerEmail %></a></dd></div>
                    <div><dt class="text-[#75869a]">Phone</dt><dd class="mt-0.5 font-semibold"><a href="tel:<%= encodeURIComponent(lead.customerPhone) %>" class="text-[#174a8b]"><%= lead.customerPhone %></a></dd></div>
                    <% if (lead.companyName) { %><div><dt class="text-[#75869a]">Company</dt><dd class="mt-0.5 font-semibold"><%= lead.companyName %></dd></div><% } %>
                    <div><dt class="text-[#75869a]">Roof steepness</dt><dd class="mt-0.5 font-semibold"><%= lead.steepness %></dd></div>
                    <div><dt class="text-[#75869a]">Building storeys</dt><dd class="mt-0.5 font-semibold"><%= lead.storeys %></dd></div>
                    <div><dt class="text-[#75869a]">Monthly bill</dt><dd class="mt-0.5 font-semibold"><%= lead.monthlyBill === null ? 'Not provided' : formatter.format(lead.monthlyBill) %></dd></div>
                    <div><dt class="text-[#75869a]">Monthly generation</dt><dd class="mt-0.5 font-semibold"><%= lead.estimate.monthlyYield.toLocaleString() %> kWh</dd></div>
                    <div><dt class="text-[#75869a]">Traced roof area</dt><dd class="mt-0.5 font-semibold"><%= Number.isFinite(lead.roofArea) ? `${lead.roofArea.toLocaleString()} m²` : 'Not traced' %></dd></div>
                    <div><dt class="text-[#75869a]">System price</dt><dd class="mt-0.5 font-semibold"><%= formatter.format(lead.estimate.basePrice) %></dd></div>
                    <div><dt class="text-[#75869a]">GST</dt><dd class="mt-0.5 font-semibold"><%= formatter.format(lead.estimate.gst) %></dd></div>
                    <div><dt class="text-[#75869a]">Roof outline</dt><dd class="mt-0.5 font-semibold"><%= lead.roofOutline.length >= 3 ? `${lead.roofOutline.length} map points saved` : 'Not drawn' %></dd></div>
                  </dl>
                  <% if (lead.postalCode) { %><a class="mt-4 flex min-h-10 items-center justify-center gap-2 rounded-xl border border-[#dbe5f1] bg-white text-xs font-bold text-[#174a8b]" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(`${lead.postalCode}, ${lead.country === 'SG' ? 'Singapore' : 'Malaysia'}`) %>" target="_blank" rel="noreferrer"><i data-lucide="map-pin" class="h-4 w-4"></i> Open property in Google Maps</a><% } %>
                  <div class="mt-4 grid grid-cols-2 gap-2.5">
                    <form action="/leads/<%= lead.id %>/status" method="POST"><input type="hidden" name="action" value="approve"><button class="flex h-11 w-full items-center justify-center gap-1.5 rounded-xl bg-[#174a8b] text-xs font-bold text-white hover:bg-[#103b72]" type="submit"><i data-lucide="check" class="h-4 w-4"></i> Approve</button></form>
                    <form action="/leads/<%= lead.id %>/status" method="POST"><input type="hidden" name="action" value="decline"><button class="flex h-11 w-full items-center justify-center gap-1.5 rounded-xl border border-[#efd9d5] bg-white text-xs font-bold text-[#a64d40] hover:bg-[#fff7f5]" type="submit"><i data-lucide="x" class="h-4 w-4"></i> Decline</button></form>
                  </div>
                </div>
              </details>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>
  <script>lucide.createIcons();</script>
</body>
</html>