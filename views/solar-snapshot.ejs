<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f3f7fc">
  <title>Solar snapshot | Gainmax</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; color: #17324f; font-family: 'DM Sans', sans-serif; background: #f3f7fc; }
    .font-display { font-family: 'Manrope', sans-serif; }
    .app-shell { max-width: 760px; min-height: 100dvh; margin: 0 auto; padding-bottom: 104px; background: #fff; box-shadow: 0 20px 70px #163e6b16; }
    @media (min-width: 800px) { .app-shell { min-height: calc(100dvh - 48px); margin: 24px auto; border: 1px solid #d6e2f0; border-radius: 22px; overflow: hidden; } }
    .brand-cta { background: #bd5200; color: #fff; transition: background .16s ease, transform .16s ease; }
    .brand-cta:hover { background: #963f00; }
    .brand-cta:focus-visible { outline: 3px solid #f28c28; outline-offset: 3px; }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
  </style>
</head>
<body>
  <% const locale = draft.estimate.currency === 'SGD' ? 'en-SG' : 'en-MY'; %>
  <% const money = new Intl.NumberFormat(locale, { style: 'currency', currency: draft.estimate.currency, maximumFractionDigits: 0 }); %>
  <% const compactMoney = new Intl.NumberFormat(locale, { style: 'currency', currency: draft.estimate.currency, notation: 'compact', maximumFractionDigits: 1 }); %>
  <% const propertyLabel = { Landed: 'Landed', Condo: 'Condo', 'C&I': 'Commercial & industrial' }[draft.details.property]; %>
  <% const areaLabel = draft.details.country === 'SG' ? 'Singapore' : 'Malaysia'; %>
  <main class="app-shell">
    <header class="flex items-center justify-between border-b border-[#e1eaf5] px-5 py-4 sm:px-8">
      <div class="flex items-center gap-2.5" aria-label="Gainmax"><span class="grid h-9 w-9 place-items-center rounded-xl bg-[#174a8b] text-[#f28c28]"><i data-lucide="sun" class="h-5 w-5"></i></span><span class="font-display text-[17px] font-extrabold">gainmax<span class="text-[#174a8b]">.</span></span></div>
      <span class="rounded-full bg-[#fff1e4] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[.6px] text-[#9d4b08]">Solar snapshot</span>
    </header>

    <div class="px-5 pb-8 pt-6 sm:px-8 sm:pt-8">
      <section aria-labelledby="summaryTitle">
        <div class="mb-4"><p class="text-[11px] font-bold uppercase tracking-[1px] text-[#687b94]">Prepared for <%= draft.details.customerName %></p><h1 id="summaryTitle" class="mt-1 font-display text-[27px] font-extrabold tracking-[-.5px]">Summary</h1></div>

        <div class="rounded-2xl border border-[#dbe5f1] bg-white p-4 sm:p-6">
          <div class="grid grid-cols-3 divide-x divide-[#d8e3ef]">
            <div class="px-2 text-center sm:px-4"><span class="mx-auto grid h-9 w-9 place-items-center rounded-xl bg-[#eaf2fc] text-[#174a8b]"><i data-lucide="panels-top-left" class="h-5 w-5"></i></span><p class="mt-2 font-display text-[21px] font-extrabold leading-tight sm:text-[25px]"><%= draft.estimate.capacityKwp.toFixed(2) %></p><p class="text-[11px] font-bold text-[#536982]">kWp</p><p class="mx-auto mt-2 max-w-[130px] text-[10px] leading-4 text-[#687b94] sm:text-xs">Recommended installation size</p></div>
            <div class="px-2 text-center sm:px-4"><span class="mx-auto grid h-9 w-9 place-items-center rounded-xl bg-[#fff1e4] text-[#a94c00]"><i data-lucide="sun" class="h-5 w-5"></i></span><p class="mt-2 font-display text-[21px] font-extrabold leading-tight sm:text-[25px]"><%= annualGenerationMwh.toFixed(2) %></p><p class="text-[11px] font-bold text-[#536982]">MWh / yr</p><p class="mx-auto mt-2 max-w-[130px] text-[10px] leading-4 text-[#687b94] sm:text-xs">Estimated clean energy</p></div>
            <div class="px-2 text-center sm:px-4"><span class="mx-auto grid h-9 w-9 place-items-center rounded-xl bg-[#edf4fc] text-[#174a8b]"><i data-lucide="wallet" class="h-5 w-5"></i></span><p class="mt-2 font-display text-[19px] font-extrabold leading-tight sm:text-[24px]"><%= compactMoney.format(annualSavings) %></p><p class="text-[11px] font-bold text-[#536982]"><%= draft.estimate.currency %> / yr</p><p class="mx-auto mt-2 max-w-[130px] text-[10px] leading-4 text-[#687b94] sm:text-xs">Estimated electricity bill savings</p></div>
          </div>

          <div class="mt-6 border-t border-[#e7edf5] pt-5">
            <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] gap-x-3 gap-y-2.5 text-xs sm:max-w-md sm:text-sm">
              <span class="font-bold text-[#425975]">Area</span><span class="text-[#536982]"><%= areaLabel %></span>
              <span class="font-bold text-[#425975]">Postal code</span><span class="text-[#536982]"><%= draft.details.postalCode || 'Not provided' %></span>
              <span class="font-bold text-[#425975]">Property type</span><span class="text-[#536982]"><%- propertyLabel %></span>
              <span class="font-bold text-[#425975]">Est. roof size</span><span class="text-[#536982]"><%= Number.isFinite(draft.details.roofArea) ? `${draft.details.roofArea.toLocaleString()} m²` : 'Not traced' %></span>
              <span class="font-bold text-[#425975]">Solar panels</span><span class="text-[#536982]"><%= draft.details.panels %> × 640 Wp</span>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap items-end justify-between gap-2 rounded-xl bg-[#123a68] px-4 py-3.5 text-white sm:px-5"><div><p class="text-[10px] font-semibold text-white/65">Estimated system cost</p><p class="mt-0.5 font-display text-xl font-extrabold"><%= money.format(draft.estimate.totalCost) %></p></div><p class="text-right text-[10px] text-white/70"><%= draft.details.country === 'SG' ? 'Includes 9% GST' : 'Before applicable taxes' %></p></div>
        </div>
      </section>

      <section class="mt-8" aria-labelledby="savingsTitle">
        <h2 id="savingsTitle" class="mb-3 font-display text-lg font-extrabold">Potential savings</h2>
        <div class="rounded-2xl bg-[#f2f4f7] p-5 sm:p-6">
          <div class="flex items-center gap-2 text-sm font-semibold text-[#425975]"><i data-lucide="receipt" class="h-4 w-4 text-[#174a8b]"></i> Savings on electricity bills</div>
          <p class="mt-3 font-display text-[27px] font-extrabold"><%= compactMoney.format(annualSavings) %></p>
          <p class="text-sm text-[#687b94]">Estimated each year</p>
          <div class="my-4 h-px max-w-[100px] bg-[#d1d9e3]"></div>
          <p class="font-display text-lg font-extrabold"><%= money.format(lifetimeSavingsLow) %> – <%= money.format(lifetimeSavingsHigh) %></p>
          <p class="text-sm text-[#687b94]">Illustrative savings over 25 years</p>
          <p class="mt-4 text-[10px] italic leading-[17px] text-[#687b94]">Savings are indicative, based on estimated generation and current bill-offset assumptions. The 25-year range assumes 0.5% annual panel degradation at the low end and no degradation at the high end. Actual savings depend on tariffs, consumption, shading, and final system design.</p>
        </div>
      </section>

      <section class="mt-8" aria-labelledby="impactTitle">
        <h2 id="impactTitle" class="mb-3 flex items-center gap-2 font-display text-lg font-extrabold">Your environmental impact <i data-lucide="leaf" class="h-4 w-4 text-[#bd5200]"></i></h2>
        <div class="grid grid-cols-3 divide-x divide-[#e2eaf4] rounded-2xl border border-[#dbe5f1] bg-white px-2 py-5 sm:px-4">
          <div class="px-2 text-center"><i data-lucide="car-front" class="mx-auto h-6 w-6 text-[#174a8b]"></i><p class="mt-2 font-display text-base font-extrabold"><%= Math.max(1, Math.round(carEquivalent)) %></p><p class="text-[10px] leading-4 text-[#687b94] sm:text-xs">cars off the road<br>per year</p></div>
          <div class="px-2 text-center"><i data-lucide="trees" class="mx-auto h-6 w-6 text-[#bd5200]"></i><p class="mt-2 font-display text-base font-extrabold"><%= Math.round(treeEquivalent).toLocaleString() %></p><p class="text-[10px] leading-4 text-[#687b94] sm:text-xs">trees' annual<br>CO₂ equivalent</p></div>
          <div class="px-2 text-center"><i data-lucide="cloud-cog" class="mx-auto h-6 w-6 text-[#174a8b]"></i><p class="mt-2 font-display text-base font-extrabold"><%= annualCo2Tonnes.toFixed(1) %> t</p><p class="text-[10px] leading-4 text-[#687b94] sm:text-xs">CO₂ reduction<br>per year</p></div>
        </div>
        <p class="mt-2 text-[10px] leading-4 text-[#75869a]">Environmental equivalents use indicative grid-emissions and equivalency factors; actual impact varies by location and system performance.</p>
      </section>
    </div>

  </main>
  <script>lucide.createIcons();</script>
</body>
</html>